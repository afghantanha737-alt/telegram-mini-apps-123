# Reference only. Put real values in the hosting provider's environment settings.
# Never commit a real .env file or real secrets to GitHub.

PORT=3000
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database
BOT_TOKEN=replace-with-telegram-bot-token
BOT_USERNAME=replace-with-bot-username
APP_URL=https://YOUR_DOMAIN
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret
ALLOWED_ORIGINS=https://YOUR_DOMAIN
INIT_DATA_MAX_AGE=86400
REFERRAL_IP_SALT=replace-with-a-long-random-secret
REFERRAL_MIN_ACCOUNT_AGE_HOURS=24
REFERRAL_MAX_DAILY_BONUSES=50

ADMIN_KEY=replace-with-admin-key
REFERRAL_MIN_TASKS=2
REFERRAL_BONUS_POINTS=50
MINI_APP_SHORT_NAME=

# TADS
TADS_WIDGET_ID=replace-with-tads-widget-id
TADS_WEBHOOK_SECRET=replace-with-a-long-random-secret
TADS_DEBUG=false
ADS_COOLDOWN_SECONDS=60
