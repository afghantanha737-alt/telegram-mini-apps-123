# ===== سرور =====
PORT=3000

# ===== دیتابیس =====
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/points-app

# ===== ربات تلگرام =====
BOT_TOKEN=123456789:AAExampleBotTokenHere
BOT_USERNAME=YourBotUsername
APP_URL=https://your-app.onrender.com
TELEGRAM_WEBHOOK_SECRET=change_this_secret

# اختیاری: اگر Mini App شما دارای "short name" در BotFather است
# (Bot Settings > Configure Mini App)، لینک رفرال مستقیماً اپ را باز می‌کند
MINI_APP_SHORT_NAME=

# آیدی عددی چت/گروه ادمین برای دریافت اسکرین‌شات‌های تسک جهت بررسی
# (برای گرفتنش: پیامی به ربات @userinfobot بفرست یا از @RawDataBot استفاده کن)
ADMIN_CHAT_ID=

# ===== امنیت پنل ادمین =====
ADMIN_KEY=change_this_admin_key

# ===== تنظیمات =====
REFERRAL_BONUS_POINTS=50
INIT_DATA_MAX_AGE=86400

# ===== CORS (اختیاری) =====
ALLOWED_ORIGINS=